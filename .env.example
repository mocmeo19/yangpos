# Khóa ký cookie đăng nhập, tối thiểu 32 ký tự.
# Tạo bằng: openssl rand -base64 32
AUTH_SECRET=

# Phát hành hóa đơn điện tử qua MISA meInvoice (API tích hợp). Bỏ trống nếu chỉ chạy thử nghiệm.
# AppID do MISA cấp khi đăng ký tích hợp; tên đăng nhập, mật khẩu là tài khoản meinvoice.vn.
MISA_MEINVOICE_APP_ID=
MISA_MEINVOICE_TAX_CODE=
MISA_MEINVOICE_USERNAME=
MISA_MEINVOICE_PASSWORD=
# "test" (testapi.meinvoice.vn, mặc định) hoặc "production" (api.meinvoice.vn).
MISA_MEINVOICE_ENVIRONMENT=test

# MongoDB lưu toàn bộ dữ liệu bán hàng. Chạy bằng: docker compose up -d
MONGODB_URI=mongodb://localhost:27019
MONGODB_DB=yangpos
